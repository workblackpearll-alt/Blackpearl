{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/book/:path*",
      "destination": "/book"
    },
    {
      "source": "/refund",
      "destination": "/cancellation"
    }
  ]
}
