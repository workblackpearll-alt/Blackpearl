# ========================================================
# BLACK PEARL · LADY ALICE - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Duplicate this file as .env and fill in your actual credentials.
# Vite client requires environment variables to start with VITE_

# --- Supabase Configuration ---
# Found in: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- ImageKit Configuration ---
# Found in: ImageKit Dashboard > Developer Options > API Keys
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id/
VITE_IMAGEKIT_PUBLIC_KEY=public_your_public_key_here

# --- Server-only secrets (Vercel: Project Settings > Environment Variables) ---
# These are read by the /api functions only. Never prefix them with VITE_,
# or they would be shipped to every visitor's browser.

# Razorpay: Dashboard > Account & Settings > API Keys (rzp_test_ for testing, rzp_live_ for real payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Razorpay: Dashboard > Webhooks > add https://YOUR-DOMAIN/api/razorpay-webhook
# with events payment.captured, order.paid, payment.failed, and paste its secret here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Supabase: Project Settings > API > service_role key (full database access, keep private)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend: resend.com > API Keys. The "from" address must be on a domain you verified in Resend.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Black Pearl <bookings@your-domain.com>"
# Optional: also send a copy of every confirmation to this address
BOOKING_NOTIFY_EMAIL=

# Public site address, used for QR codes and links in emails
SITE_URL=https://your-domain.com
